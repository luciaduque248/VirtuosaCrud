# Local development only. In Vercel the frontend uses /api on the same domain.
REACT_APP_API_URL=http://localhost:4000/api

# Server variables (configure as secrets in Vercel; never commit real values).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DB_POOL_MAX=5
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000/VirtuosaCrud
CLIENT_URLS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
RESEND_API_KEY=
EMAIL_FROM=Virtuosa <onboarding@resend.dev>
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
